@model ReadBooks.Models.Categoria

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<h2 class="text-danger">Eliminar Categoría</h2>
<h3>¿Estás seguro de que deseas eliminar esta categoría?</h3>

<div class="card col-md-6 mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Confirmar Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
