@model Prestamo

<div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 min-h-screen p-4">
    <div class="bg-white rounded-lg shadow-lg w-full max-w-md overflow-hidden">

        <div class="bg-brandDark px-6 py-4 flex justify-between items-center">
            <h2 class="text-lg font-bold text-white">Registrar Devolución</h2>
            <button type="button" class="cerrar-modal text-white hover:text-gray-300">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <div class="p-6">
            <p class="font-semibold text-brandDark mb-1">Libro: @Model.Libro?.Titulo</p>
            <p class="text-gray-600 mb-4">Devuelto por: <span class="font-semibold">@Model.Estudiante?.Nombre @Model.Estudiante?.Apellido</span></p>

            <hr class="mb-4" />

            <form id="formConfirmarDevolucion" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="prestamoId" value="@Model.Id" />

                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Condición al devolver</label>
                    <select name="condicionAlDevolver" class="w-full bg-gray-50 border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brandBlue" required>
                        <option value="">Seleccione una opción</option>
                        @foreach (var item in Html.GetEnumSelectList<CondicionLibro>())
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>

                <div class="flex justify-end gap-3">
                    <button type="button" class="cerrar-modal px-5 py-2 rounded-md bg-brandBlue text-white hover:opacity-90">
                        Cancelar
                    </button>
                    <button type="submit" class="px-5 py-2 rounded-md bg-brandRed text-white hover:bg-brandRedHover">
                        Confirmar devolución
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>