@model List<Prestamo>

@{
    ViewData["Title"] = "Gestión de Préstamos";
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-brandDark">Gestión de Préstamos</h1>

    <button type="button" class="btn-abrir-create bg-brandDark text-white px-4 py-2 rounded-md text-sm font-medium flex items-center gap-2 hover:opacity-90">
        <i class="fa-solid fa-plus"></i> Registrar Préstamo
    </button>
</div>

<div class="overflow-x-auto rounded-lg shadow">
    <table class="min-w-full bg-white">
        <thead class="bg-brandDark text-white">
            <tr>
                <th class="text-left px-6 py-3 text-sm font-semibold">Libro</th>
                <th class="text-left px-6 py-3 text-sm font-semibold">Estudiante</th>
                <th class="text-left px-6 py-3 text-sm font-semibold">Fecha Inicio</th>
                <th class="text-left px-6 py-3 text-sm font-semibold">Fecha Devolución</th>
                <th class="text-left px-6 py-3 text-sm font-semibold">Estado</th>
                <th class="text-left px-6 py-3 text-sm font-semibold">Acciones</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
            @foreach (var p in Model)
            {
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 font-semibold text-brandDark">@p.Libro?.Titulo</td>
                    <td class="px-6 py-4 text-gray-600">@p.Estudiante?.Nombre @p.Estudiante?.Apellido</td>
                    <td class="px-6 py-4 text-gray-600">@p.Fecha.ToString("d/M/yyyy")</td>
                    <td class="px-6 py-4 text-gray-600">@p.FechaDevolucionProgramada.ToString("d/M/yyyy")</td>
                    <td class="px-6 py-4">
                        @if (p.Estado == EstadoPrestamo.PRESTADO)
                        {
                            <span class="bg-yellow-100 text-yellow-700 text-xs font-semibold px-3 py-1 rounded-full">PRESTADO</span>
                        }
                        else
                        {
                            <span class="bg-green-100 text-green-700 text-xs font-semibold px-3 py-1 rounded-full">DEVUELTO</span>
                        }
                    </td>
                    <td class="px-6 py-4">
                        @if (p.Estado == EstadoPrestamo.PRESTADO)
                        {
                            <button type="button" class="btn-devolver text-brandRed hover:underline flex items-center gap-1" data-id="@p.Id">
                                <i class="fa-solid fa-rotate-left"></i> Devolver
                            </button>
                        }
                        else
                        {
                            <span class="text-gray-400">-</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <p class="text-center text-gray-500 py-6">No hay préstamos registrados todavía.</p>
    }
</div>

<div id="modalContainer"></div>

@section Scripts {
    <script>
        function mostrarToast(mensaje, tipo = 'success') {

            const anterior = document.getElementById('toast-success');
            if (anterior) anterior.remove();

            const colorIcono = tipo === 'success'
                ? 'text-green-500 bg-green-100 dark:bg-green-800 dark:text-green-200'
                : 'text-red-500 bg-red-100 dark:bg-red-800 white:text-red-200';

            const iconoSvg = tipo === 'success'
                ? '<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z" />'
                : '<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 12.293a1 1 0 0 1-1.414 1.414L10 11.914l-2.293 2.293a1 1 0 0 1-1.414-1.414L8.586 10.5 6.293 8.207a1 1 0 0 1 1.414-1.414L10 9.086l2.293-2.293a1 1 0 0 1 1.414 1.414L11.414 10.5l2.293 2.293Z" />';

            const toast = document.createElement('div');
            toast.id = 'toast-success';
            toast.setAttribute('role', 'alert');

            toast.className = 'fixed top-6 right-6 z-[100] flex items-center w-full max-w-xs p-4 mb-4 text-gray-700 bg-white rounded-xl shadow-lg border border-gray-100';

            toast.innerHTML = `
                        <div class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 rounded-lg ${colorIcono}">
                            <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                                ${iconoSvg}
                            </svg>
                            <span class="sr-only">Icon</span>
                        </div>
                        <div class="ml-3 text-sm font-medium text-gray-600">${mensaje}</div>
                        <button type="button" onclick="document.getElementById('toast-success').remove()" class="ml-auto -mx-1.5 -my-1.5 bg-transparent text-gray-400 hover:text-gray-900 rounded-lg focus:ring-2 focus:ring-gray-300 p-1.5 hover:bg-gray-100 inline-flex items-center justify-center h-8 w-8">
                            <span class="sr-only">Close</span>
                            <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                            </svg>
                        </button>
                    `;

            document.body.appendChild(toast);

            setTimeout(() => {
                const t = document.getElementById('toast-success');
                if (t) t.remove();
            }, 5000);
        }

        async function cargarModal(url) {
            const res = await fetch(url);
            if (!res.ok) {
                alert('No se pudo cargar la información.');
                return;
            }
            const html = await res.text();
            document.getElementById('modalContainer').innerHTML = html;
        }

        function cerrarModal() {
            document.getElementById('modalContainer').innerHTML = '';
        }

        function sincronizarIdDesdeTexto(inputTexto, datalistId, inputIdOculto) {
            const datalist = document.getElementById(datalistId);
            const inputOculto = document.getElementById(inputIdOculto);
            const opciones = datalist.querySelectorAll('option');
            let encontrado = false;

            opciones.forEach(opcion => {
                if (opcion.value === inputTexto.value) {
                    inputOculto.value = opcion.getAttribute('data-id');
                    encontrado = true;
                }
            });

            if (!encontrado) {
                inputOculto.value = '0';
            }
        }

        document.addEventListener('click', function (e) {
            if (e.target.closest('.btn-abrir-create')) {
                cargarModal('/Prestamo/Create');
            }

            const btnDevolver = e.target.closest('.btn-devolver');
            if (btnDevolver) {
                cargarModal('/Prestamo/RegistrarDevolucion/' + btnDevolver.dataset.id);
            }

            if (e.target.closest('.cerrar-modal')) {
                cerrarModal();
            }
        });

        document.addEventListener('input', function (e) {
            if (e.target.id === 'inputLibroTexto') {
                sincronizarIdDesdeTexto(e.target, 'listaLibros', 'inputLibroId');
            }

            if (e.target.id === 'inputEstudianteTexto') {
                sincronizarIdDesdeTexto(e.target, 'listaEstudiantes', 'inputEstudianteId');
            }
        });

        document.addEventListener('submit', async function (e) {
            if (e.target.id === 'formCrearPrestamo') {
                e.preventDefault();
                const formData = new FormData(e.target);

                const res = await fetch('/Prestamo/Create', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();

                if (data.success) {
                    cerrarModal();
                    mostrarToast(data.message, 'success');
                    setTimeout(() => location.reload(), 1200);
                } else {
                    mostrarToast(data.message, 'error');
                }
            }

            if (e.target.id === 'formConfirmarDevolucion') {
                e.preventDefault();

                const formData = new FormData(e.target);
                const urlEncodedData = new URLSearchParams(formData);

                const res = await fetch('/Prestamo/ConfirmarDevolucion', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: urlEncodedData
                });
                const data = await res.json();

                if (data.success) {
                    cerrarModal();
                    mostrarToast(data.message, 'success');
                    setTimeout(() => location.reload(), 1200);
                } else {
                    mostrarToast(data.message, 'error');
                }
            }
        });
    </script>
}