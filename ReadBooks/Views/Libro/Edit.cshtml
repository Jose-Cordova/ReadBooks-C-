@model ReadBooks.Models.Libro

@{
    ViewData["Title"] = "Editar Libro";
}

<!-- Título -->
<div class="border-b pb-4 mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Editar Libro</h1>
</div>

<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6 md:p-8 max-w-4xl">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-brandRed text-sm mb-4"></div>
        <input type="hidden" asp-for="Id" />
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- Título -->
            <div class="col-span-1 md:col-span-2">
                <label asp-for="Titulo" class="block text-sm font-medium text-gray-700 mb-1">Título del Libro</label>
                <input asp-for="Titulo" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-brandBlue focus:border-brandBlue focus:outline-none transition-colors" />
                <span asp-validation-for="Titulo" class="text-brandRed text-xs mt-1 block"></span>
            </div>
            
            <!-- Año de Publicación -->
            <div>
                <label asp-for="AnioPublicacion" class="block text-sm font-medium text-gray-700 mb-1">Año de Publicación</label>
                <input asp-for="AnioPublicacion" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-brandBlue focus:border-brandBlue focus:outline-none transition-colors" type="number" />
                <span asp-validation-for="AnioPublicacion" class="text-brandRed text-xs mt-1 block"></span>
            </div>
            
            <!-- Autor -->
            <div>
                <label asp-for="AutorId" class="block text-sm font-medium text-gray-700 mb-1">Autor</label>
                <select asp-for="AutorId" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-brandBlue focus:border-brandBlue focus:outline-none transition-colors bg-white" asp-items="ViewBag.AutorId"></select>
                <span asp-validation-for="AutorId" class="text-brandRed text-xs mt-1 block"></span>
            </div>

            <!-- Categoría -->
            <div>
                <label asp-for="CategoriaId" class="block text-sm font-medium text-gray-700 mb-1">Categoría</label>
                <select asp-for="CategoriaId" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-brandBlue focus:border-brandBlue focus:outline-none transition-colors bg-white" asp-items="ViewBag.CategoriaId"></select>
                <span asp-validation-for="CategoriaId" class="text-brandRed text-xs mt-1 block"></span>
            </div>

            <!-- Total Ejemplares -->
            <div>
                <label asp-for="TotalEjemplares" class="block text-sm font-medium text-gray-700 mb-1">Total de Ejemplares</label>
                <input asp-for="TotalEjemplares" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-brandBlue focus:border-brandBlue focus:outline-none transition-colors" type="number" min="0" />
                <span asp-validation-for="TotalEjemplares" class="text-brandRed text-xs mt-1 block"></span>
            </div>

            <!-- Ejemplares Disponibles -->
            <div>
                <label asp-for="EjemplaresDisponibles" class="block text-sm font-medium text-gray-700 mb-1">Ejemplares Disponibles</label>
                <input asp-for="EjemplaresDisponibles" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-brandBlue focus:border-brandBlue focus:outline-none transition-colors" type="number" min="0" />
                <span asp-validation-for="EjemplaresDisponibles" class="text-brandRed text-xs mt-1 block"></span>
            </div>
            
        </div>

        <!-- Botones -->
        <div class="mt-8 flex gap-4 pt-4 border-t border-gray-100">
            <button type="submit" class="bg-yellow-500 hover:bg-yellow-600 text-white px-6 py-2.5 rounded-md font-semibold transition-colors shadow-sm flex items-center gap-2">
                <i class="fa-solid fa-arrows-rotate"></i> Actualizar Libro
            </button>
            <a asp-action="Index" class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-6 py-2.5 rounded-md font-semibold transition-colors flex items-center gap-2">
                <i class="fa-solid fa-xmark"></i> Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
