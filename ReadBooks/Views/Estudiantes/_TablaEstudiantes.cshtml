@model List<Estudiante>

@foreach (var est in Model)
{
    <tr class="hover:bg-gray-50">
        <td class="px-6 py-4 font-semibold text-brandDark">@est.Nombre @est.Apellido</td>
        <td class="px-6 py-4 text-gray-600">@est.Carnet</td>
        <td class="px-6 py-4 text-gray-600">@est.Telefono</td>
        <td class="px-6 py-4 flex gap-3">
            <button onclick="abrirModal('/Estudiantes/Edit/@est.Id')"
                    class="text-green-600 hover:text-green-800">
                <i class="fa-solid fa-pen-to-square"></i>
            </button>
            <button onclick="abrirModal('/Estudiantes/Delete/@est.Id')"
                    class="text-red-600 hover:text-red-800">
                <i class="fa-solid fa-trash"></i>
            </button>
        </td>
    </tr>
}

@if (!Model.Any())
{

    <tr>
        <td colspan="4" class="text-center text-gray-500 py-6">
            No se encontraron estudiantes que coincidan con la búsqueda.
        </td>
    </tr>
}