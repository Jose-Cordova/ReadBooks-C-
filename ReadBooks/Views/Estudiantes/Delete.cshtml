@model Estudiante

@{
    ViewData["Title"] = "Eliminar Estudiante";
    Layout = null;
}

<div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 min-h-screen p-4">
    <div class="bg-white rounded-lg shadow-lg w-full max-w-md overflow-hidden">

        <div class="bg-brandRed px-6 py-4 flex justify-between items-center">
            <h2 class="text-lg font-bold text-white">Eliminar Estudiante</h2>
            <!-- Cambiado a botón JS para cerrar -->
            <button onclick="cerrarModal()" class="text-white hover:text-gray-200">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <div class="p-6">
            <p class="text-gray-600 mb-6">
                ¿Estás seguro de que deseas eliminar a este estudiante y su historial de préstamos?
            </p>

            <form asp-controller="Estudiantes" asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                <div class="flex justify-end gap-3">
                    <!-- Cambiado a botón JS para cerrar -->
                    <button type="button" onclick="cerrarModal()"
                            class="px-5 py-2 rounded-md bg-brandBlue text-white hover:opacity-90">
                        Cancelar
                    </button>
                    <button type="submit" class="px-5 py-2 rounded-md bg-brandRed text-white hover:bg-brandRedHover">
                        Eliminar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
