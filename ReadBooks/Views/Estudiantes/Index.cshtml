@model List<Estudiante>

@{
    ViewData["Title"] = "Gestión de Estudiantes";
}

<div class="flex justify-between items-center mb-6 flex-wrap gap-4">
    <h1 class="text-2xl font-bold text-brandDark">Gestión de Estudiantes</h1>

    <div class="flex items-center gap-3">

        <input type="text"
               id="inputBuscar"
               oninput="filtrarEstudiantes()"
               placeholder="Buscar por nombre o carnet..."
               class="border border-gray-300 rounded-md px-3 py-2 text-sm w-64 focus:outline-none focus:ring-2 focus:ring-brandBlue" />

        <button onclick="abrirModal('/Estudiantes/Create')"
                class="bg-brandDark text-white px-4 py-2 rounded-md text-sm font-medium flex items-center gap-2 hover:opacity-90">
            <i class="fa-solid fa-plus"></i> Registrar Estudiante
        </button>
    </div>
</div>

<div class="overflow-x-auto rounded-lg shadow">
    <table class="min-w-full bg-white">
        <thead class="bg-brandDark text-white">
            <tr>
                <th class="text-left px-6 py-3 text-sm font-semibold">Nombre Completo</th>
                <th class="text-left px-6 py-3 text-sm font-semibold">Carnet</th>
                <th class="text-left px-6 py-3 text-sm font-semibold">Teléfono</th>
                <th class="text-left px-6 py-3 text-sm font-semibold">Acciones</th>
            </tr>
        </thead>
        <tbody id="tablaCuerpo" class="divide-y divide-gray-200">
            @await Html.PartialAsync("_TablaEstudiantes", Model)
        </tbody>
    </table>
</div>

<div id="modalContainer"></div>

<script>
    function mostrarToast(mensaje, tipo = 'success') {

        const anterior = document.getElementById('toast-success');
        if (anterior) anterior.remove();

        const colorIcono = tipo === 'success'
            ? 'text-green-500 bg-green-100 dark:bg-green-800 dark:text-green-200'
            : 'text-red-500 bg-red-100 dark:bg-red-800 white:text-red-200';

        const iconoSvg = tipo === 'success'
            ? '<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z" />'
            : '<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 12.293a1 1 0 0 1-1.414 1.414L10 11.914l-2.293 2.293a1 1 0 0 1-1.414-1.414L8.586 10.5 6.293 8.207a1 1 0 0 1 1.414-1.414L10 9.086l2.293-2.293a1 1 0 0 1 1.414 1.414L11.414 10.5l2.293 2.293Z" />';

        const toast = document.createElement('div');
        toast.id = 'toast-success';
        toast.setAttribute('role', 'alert');

        toast.className = 'fixed top-6 right-6 z-[100] flex items-center w-full max-w-xs p-4 mb-4 text-gray-700 bg-white rounded-xl shadow-lg border border-gray-100';

        toast.innerHTML = `
            <div class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 rounded-lg ${colorIcono}">
                <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                    ${iconoSvg}
                </svg>
                <span class="sr-only">Icon</span>
            </div>
            <div class="ml-3 text-sm font-medium text-gray-600">${mensaje}</div>
            <button type="button" onclick="document.getElementById('toast-success').remove()" class="ml-auto -mx-1.5 -my-1.5 bg-transparent text-gray-400 hover:text-gray-900 rounded-lg focus:ring-2 focus:ring-gray-300 p-1.5 hover:bg-gray-100 inline-flex items-center justify-center h-8 w-8">
                <span class="sr-only">Close</span>
                <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
            </button>
        `;

        document.body.appendChild(toast);

        setTimeout(() => {
            const t = document.getElementById('toast-success');
            if (t) t.remove();
        }, 5000);
    }

    function filtrarEstudiantes() {
        const texto = document.getElementById('inputBuscar').value;

        fetch(`/Estudiantes/Buscar?buscar=${encodeURIComponent(texto)}`)
            .then(response => response.text())
            .then(html => {
                document.getElementById('tablaCuerpo').innerHTML = html;
            })
            .catch(error => console.error('Error al filtrar:', error));
    }

    function abrirModal(url) {
        fetch(url)
            .then(response => response.text())
            .then(html => {
                document.getElementById('modalContainer').innerHTML = html;
            })
            .catch(error => console.error('Error al cargar el modal:', error));
    }

    function cerrarModal() {
        document.getElementById('modalContainer').innerHTML = '';
    }


        function enviarFormularioCrear(event) {
        event.preventDefault();

        const form = document.getElementById('formCrearEstudiante');
        const formData = new FormData(form);

        fetch(form.action, {
            method: 'POST',
            body: formData,
            redirect: 'manual'
        })
            .then(response => {
             
                if (response.type === 'opaqueredirect' || response.status === 0) {
                    window.location.href = '/Estudiantes/Index';
                    return null;
                }
                return response.text();
            })
            .then(html => {
                if (html) {
                    document.getElementById('modalContainer').innerHTML = html;
                }
            })
            .catch(error => console.error('Error al guardar:', error));
    }


    function enviarFormularioEditar(event) {
        event.preventDefault();

        const form = document.getElementById('formEditarEstudiante');
        const formData = new FormData(form);

        fetch(form.action, {
            method: 'POST',
            body: formData,
            redirect: 'manual'
        })
            .then(response => {
                if (response.type === 'opaqueredirect' || response.status === 0) {
                    window.location.href = '/Estudiantes/Index';
                    return null;
                }
                return response.text();
            })
            .then(html => {
                if (html) {
                    document.getElementById('modalContainer').innerHTML = html;
                }
            })
            .catch(error => console.error('Error al actualizar:', error));
    }

    @if (TempData["Success"] != null)
    {
        <text>
        document.addEventListener('DOMContentLoaded', function () {
            mostrarToast('@Html.Raw(TempData["Success"])', 'success');
        });
        </text>
    }
        @if (TempData["Error"] != null)
        {
            <text>
                    document.addEventListener('DOMContentLoaded', function () {
                        mostrarToast('@Html.Raw(TempData["Error"])', 'error');
                    });
            </text>
    }
</script>